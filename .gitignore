# =============================================================================
# XYD AI Large Analytics Model - Git Ignore Rules
# Angular 22 + TypeScript + Tailwind CSS 4 + SCSS
# See: https://docs.github.com/get-started/getting-started-with-git/ignoring-files
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
/node_modules
/.pnp
/.pnp.*
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/sdks
!/.yarn/versions
/yarn.lock
pnpm-lock.yaml
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Build output and caches
# -----------------------------------------------------------------------------
/dist
/out-tsc
/bazel-out
/tmp
/.angular
!.angular/README.md
/coverage
/connect.lock
/libpeerconnection.log
testem.log
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Environment variables and local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.local
*.local.*
/config.local.*
/appsettings.local.*
/appsettings.*.local.*

# -----------------------------------------------------------------------------
# Secrets, credentials and certificates
# -----------------------------------------------------------------------------
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.npmrc
.yarnrc.yml
.secrets
secrets.*
*credentials*.json
*service-account*.json

# -----------------------------------------------------------------------------
# Logs and diagnostics
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock
profiles/
*.heapsnapshot
*.cpuprofile

# -----------------------------------------------------------------------------
# Testing and reporting
# -----------------------------------------------------------------------------
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/cypress/videos/
/cypress/screenshots/
__screenshots__/
.nyc_output/

# -----------------------------------------------------------------------------
# IDEs, editors and tooling
# -----------------------------------------------------------------------------
.idea/
.project
.classpath
.c9/
.settings/
.history/
*.launch
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# Keep shared VS Code workspace configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
/typings
*.orig
*.rej
*.bak
*.swp
*~
